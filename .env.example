# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=fr

# Database — Neon PostgreSQL (Payload Postgres adapter)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/dbname?sslmode=require

# Payload
PAYLOAD_SECRET=change-me-to-a-long-random-string
PREVIEW_SECRET=change-me-preview-secret
CRON_SECRET=change-me-cron-secret

# Cloudflare R2 (S3-compatible) — public media
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://media.yourdomain.com

# Private bucket — quote attachments (never public)
R2_PRIVATE_BUCKET=
R2_PRIVATE_ACCESS_KEY_ID=
R2_PRIVATE_SECRET_ACCESS_KEY=

# MapLibre tile/style provider
MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

# Email (SMTP abstraction)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@sogica.ml

# Optional: disable R2 in local dev (uses Payload local storage fallback)
USE_LOCAL_MEDIA=true
